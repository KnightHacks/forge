{
  "name": "@forge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./src/schemas/*.ts"
    },
    "./env": "./src/env.ts",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "classify:club-roles": "pnpm with-env tsx scripts/classify-club-roles.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "pnpm with-env drizzle-kit generate && prettier --write \"drizzle/meta/*.json\"",
    "lint": "eslint",
    "migrate": "pnpm with-env drizzle-kit migrate",
    "push": "pnpm with-env drizzle-kit push",
    "preflight:issues": "pnpm with-env tsx scripts/preflight-issues.ts",
    "preflight:hacker-sdk": "pnpm with-env tsx scripts/preflight-hacker-sdk.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "test": "NODE_ENV=test pnpm with-env vitest run --passWithNoTests",
    "test:watch": "NODE_ENV=test pnpm with-env vitest --passWithNoTests"
  },
  "dependencies": {
    "@forge/consts": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.19.0",
    "superjson": "2.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forge/eslint-config": "workspace:*",
    "@forge/prettier-config": "workspace:*",
    "@forge/tsconfig": "workspace:*",
    "@types/pg": "^8.16.0",
    "discord-api-types": "^0.38.40",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  },
  "prettier": "@forge/prettier-config"
}
