{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./minio/minio-client": "./src/minio/minio-client.ts",
    "./profile-picture": {
      "types": "./src/utils/profile-picture/public-url.ts",
      "default": "./src/utils/profile-picture/public-url.ts"
    },
    "./discord-archive.server": {
      "types": "./src/discord-archive.server.ts",
      "default": "./src/discord-archive.server.ts"
    },
    "./resume-bundle.server": {
      "types": "./src/resume-bundle.server.ts",
      "default": "./src/resume-bundle.server.ts"
    },
    "./hacker-portal": {
      "types": "./src/hacker-portal/index.ts",
      "default": "./src/hacker-portal/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "NODE_ENV=test pnpm with-env vitest run --passWithNoTests",
    "test:watch": "NODE_ENV=test pnpm with-env vitest --passWithNoTests",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@forge/auth": "workspace:*",
    "@forge/consts": "workspace:*",
    "@forge/db": "workspace:*",
    "@forge/email": "workspace:^",
    "@forge/hacker-sdk": "workspace:*",
    "@forge/utils": "workspace:*",
    "@forge/validators": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "@trpc/server": "catalog:",
    "archiver": "^6.0.2",
    "discord-api-types": "^0.38.40",
    "minio": "^8.0.6",
    "qrcode": "^1.5.4",
    "stripe": "^20.4.0",
    "superjson": "2.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forge/eslint-config": "workspace:*",
    "@forge/prettier-config": "workspace:*",
    "@forge/tsconfig": "workspace:*",
    "@types/archiver": "^6.0.3",
    "@types/json-schema": "^7.0.15",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  },
  "prettier": "@forge/prettier-config"
}
