{
  "name": "@forge/2025",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production pnpm with-env next build",
    "check": "next lint && tsc --noEmit",
    "dev": "pnpm with-env next dev --port 3002",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint",
    "preview": "pnpm build && serve out -l 3002",
    "start": "serve out -l 3002",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "analyze:react": "tsx ../../scripts/analyze-react.ts src",
    "analyze:react:changed": "tsx ../../scripts/analyze-react-changed.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@forge/ui": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-icons": "^1.3.2",
    "framer-motion": "^12.34.3",
    "minimatch": "^10.2.4",
    "next": "^16.2.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serve": "^14.2.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "eslint-config-next": "^16.2.7",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "pnpm@9.14.2"
}
