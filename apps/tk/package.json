{
  "name": "@forge/tk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "start": "pnpm with-env tsx src/index.ts",
    "build": "echo 'noop: no build operation to perform'",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@forge/api": "workspace:*",
    "@forge/consts": "workspace:*",
    "@forge/db": "workspace:*",
    "@forge/utils": "workspace:*",
    "@forge/validators": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "discord.js": "^14.25.1",
    "jimp": "^1.6.0",
    "natural": "^8.1.0",
    "sharp": "^0.35.3",
    "tsx": "^4.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forge/eslint-config": "workspace:*",
    "@forge/prettier-config": "workspace:*",
    "@forge/tsconfig": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  },
  "prettier": "@forge/prettier-config"
}
