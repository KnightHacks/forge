{
  "name": "forge",
  "private": true,
  "engines": {
    "node": ">=20.16.0",
    "pnpm": "^9.6.0"
  },
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "analyze:react": "tsx scripts/analyze-react.ts",
    "analyze:react:all": "turbo run analyze:react",
    "analyze:react:changed": "tsx scripts/analyze-react-changed.ts",
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:bootstrap": "pnpm --filter=@forge/db with-env tsx scripts/bootstrap-superadmin.ts",
    "db:generate": "pnpm --filter=@forge/db generate",
    "db:migrate": "pnpm --filter=@forge/db migrate",
    "db:pull": "pnpm --filter=@forge/db with-env tsx scripts/get_prod_db.ts",
    "db:push": "turbo -F @forge/db push",
    "db:studio": "turbo -F @forge/db studio",
    "dev": "turbo watch dev --continue",
    "dev:blade": "turbo watch dev -F @forge/blade...",
    "forge:feature": "tsx scripts/create-forge-feature.ts",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "knip": "knip --no-exit-code",
    "knip:strict": "knip",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:e2e": "turbo run e2e",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "verify:precommit": "pnpm analyze:react:changed && pnpm format && pnpm lint && pnpm typecheck",
    "verify:push": "pnpm format && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@forge/eslint-config": "workspace:*",
    "@forge/prettier-config": "workspace:*",
    "@forge/tailwind-config": "workspace:*",
    "@forge/tsconfig": "workspace:*",
    "@turbo/gen": "^2.8.11",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "playwright": "^1.61.1",
    "prettier": "catalog:",
    "react-analyzer": "github:azer/react-analyzer",
    "tsx": "^4.21.0",
    "turbo": "^2.8.11",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "prettier": "@forge/prettier-config"
}
